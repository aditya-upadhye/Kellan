LLM_MODE=mock                 # mock | off | foundry
TRANSPORT=local               # local | eventhubs
STORE=memory                  # memory | cosmos
FOUNDRY_PROJECT_ENDPOINT=
FAST_MODEL=
STRONG_MODEL=
EVENTHUBS_FQDN=
EVENTHUBS_NAME=matchlens
EVENTHUBS_CONSUMER_GROUP=$Default
COSMOS_ENDPOINT=
COSMOS_DATABASE=matchlens
COSMOS_CONTAINER=metrics
APPLICATIONINSIGHTS_CONNECTION_STRING=
FAULT_INJECT_RATE=0.0
FACTCHECK_QUALITATIVE=off
JUDGE_MODE=false
LLM_REQUEST_TIMEOUT_SECONDS=12
LLM_REQUEST_ATTEMPTS=2
INSIGHT_GENERATION_TIMEOUT_SECONDS=90
MAX_CONCURRENT_MATCHES=2
MAX_LLM_CALLS_PER_MATCH=400
MAX_MATCH_STARTS_PER_IP_PER_HOUR=3
MATCH_IDLE_TIMEOUT_SECONDS=900
TRUST_PROXY_CLIENT_IP=false
