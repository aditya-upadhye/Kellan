{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrackingFrame",
  "$defs": {
    "MatchClock": {
      "additionalProperties": false,
      "properties": {
        "period": {
          "enum": [
            1,
            2
          ],
          "type": "integer"
        },
        "ms": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "period",
        "ms"
      ],
      "title": "MatchClock",
      "type": "object"
    },
    "PlayerPos": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "pattern": "^[ha]\\d{2}$",
          "type": "string"
        },
        "x": {
          "maximum": 105.0,
          "minimum": 0.0,
          "type": "number"
        },
        "y": {
          "maximum": 68.0,
          "minimum": 0.0,
          "type": "number"
        },
        "speed_kmh": {
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "player_id",
        "x",
        "y",
        "speed_kmh"
      ],
      "title": "PlayerPos",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 105.0,
          "minimum": 0.0,
          "type": "number"
        },
        "y": {
          "maximum": 68.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "match_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "type": "string"
    },
    "frame_seq": {
      "minimum": 1,
      "type": "integer"
    },
    "clock": {
      "$ref": "#/$defs/MatchClock"
    },
    "ball": {
      "$ref": "#/$defs/Point"
    },
    "ball_speed_kmh": {
      "minimum": 0.0,
      "type": "number"
    },
    "players": {
      "items": {
        "$ref": "#/$defs/PlayerPos"
      },
      "type": "array"
    }
  },
  "required": [
    "match_id",
    "frame_seq",
    "clock",
    "ball",
    "ball_speed_kmh",
    "players"
  ],
  "type": "object"
}
