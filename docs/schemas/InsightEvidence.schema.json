{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InsightEvidence",
  "$defs": {
    "AgentTrace": {
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "match_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "moment_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent": {
          "enum": [
            "detector",
            "explainer",
            "fact_checker",
            "personalizer",
            "producer"
          ],
          "type": "string"
        },
        "action": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "approved",
            "rejected",
            "retry",
            "fallback",
            "error"
          ],
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "tokens_in": {
          "minimum": 0,
          "type": "integer"
        },
        "tokens_out": {
          "minimum": 0,
          "type": "integer"
        },
        "detail": {
          "maxLength": 200,
          "type": "string"
        },
        "draft_text": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ts": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "match_id",
        "moment_id",
        "agent",
        "action",
        "status",
        "latency_ms",
        "tokens_in",
        "tokens_out",
        "detail",
        "draft_text",
        "ts"
      ],
      "title": "AgentTrace",
      "type": "object"
    },
    "BallOutEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string"
        },
        "match_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "clock": {
          "$ref": "#/$defs/MatchClock"
        },
        "type": {
          "const": "ball_out",
          "type": "string"
        },
        "team_id": {
          "anyOf": [
            {
              "enum": [
                "home",
                "away"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "player_id": {
          "anyOf": [
            {
              "pattern": "^[ha]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "$ref": "#/$defs/Point"
        },
        "end_location": {
          "type": "null"
        },
        "outcome": {
          "type": "null"
        },
        "attrs": {
          "$ref": "#/$defs/NoAttrs"
        }
      },
      "required": [
        "event_id",
        "match_id",
        "seq",
        "clock",
        "type",
        "team_id",
        "player_id",
        "location",
        "end_location",
        "outcome",
        "attrs"
      ],
      "title": "BallOutEvent",
      "type": "object"
    },
    "BallSample": {
      "additionalProperties": false,
      "description": "Authored synthetic ball movement within the preceding tracking second.",
      "properties": {
        "offset_ms": {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "maximum": 105.0,
          "minimum": 0.0,
          "type": "number"
        },
        "y": {
          "maximum": 68.0,
          "minimum": 0.0,
          "type": "number"
        },
        "height_m": {
          "maximum": 12.0,
          "minimum": 0.0,
          "type": "number"
        },
        "action": {
          "enum": [
            "pass",
            "carry",
            "shot",
            "hold",
            "receive",
            "block",
            "save"
          ],
          "type": "string"
        },
        "actor_id": {
          "anyOf": [
            {
              "pattern": "^[ha]\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "preparing": {
          "type": "boolean"
        }
      },
      "required": [
        "offset_ms",
        "x",
        "y",
        "height_m",
        "action",
        "actor_id",
        "event_id",
        "progress",
        "preparing"
      ],
      "title": "BallSample",
      "type": "object"
    },
    "CardAttrs": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "CardAttrs",
      "type": "object"
    },
    "CardEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string"
        },
        "match_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "clock": {
          "$ref": "#/$defs/MatchClock"
        },
        "type": {
          "const": "card",
          "type": "string"
        },
        "team_id": {
          "enum": [
            "home",
            "away"
          ],
          "type": "string"
        },
        "player_id": {
          "pattern": "^[ha]\\d{2}$",
          "type": "string"
        },
        "location": {
          "type": "null"
        },
        "end_location": {
          "type": "null"
        },
        "outcome": {
          "enum": [
            "yellow",
            "second_yellow",
            "red"
          ],
          "type": "string"
        },
        "attrs": {
          "$ref": "#/$defs/CardAttrs"
        }
      },
      "required": [
        "event_id",
        "match_id",
        "seq",
        "clock",
        "type",
        "team_id",
        "player_id",
        "location",
        "end_location",
        "outcome",
        "attrs"
      ],
      "title": "CardEvent",
      "type": "object"
    },
    "CarryAttrs": {
      "additionalProperties": false,
      "properties": {
        "distance_m": {
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "distance_m"
      ],
      "title": "CarryAttrs",
      "type": "object"
    },
    "CarryEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string"
        },
        "match_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "clock": {
          "$ref": "#/$defs/MatchClock"
        },
        "type": {
          "const": "carry",
          "type": "string"
        },
        "team_id": {
          "enum": [
            "home",
            "away"
          ],
          "type": "string"
        },
        "player_id": {
          "pattern": "^[ha]\\d{2}$",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Point"
        },
        "end_location": {
          "$ref": "#/$defs/Point"
        },
        "outcome": {
          "type": "null"
        },
        "attrs": {
          "$ref": "#/$defs/CarryAttrs"
        }
      },
      "required": [
        "event_id",
        "match_id",
        "seq",
        "clock",
        "type",
        "team_id",
        "player_id",
        "location",
        "end_location",
        "outcome",
        "attrs"
      ],
      "title": "CarryEvent",
      "type": "object"
    },
    "CheckError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "unknown_metric",
            "value_mismatch",
            "uncited_number",
            "span_not_found",
            "unsupported_claim",
            "too_long"
          ],
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "CheckError",
      "type": "object"
    },
    "CheckerResult": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "attempts": {
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "passed",
        "attempts",
        "version"
      ],
      "title": "CheckerResult",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "text_span": {
          "minLength": 1,
          "type": "string"
        },
        "metric_id": {
          "pattern": "^(match|team|player|event)(\\.[A-Za-z0-9_-]+)+$",
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "as_of_seq": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "claim_id",
        "text_span",
        "metric_id",
        "value",
        "as_of_seq"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimEvidence": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "$ref": "#/$defs/Claim"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "recomputed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "recomputation": {
          "enum": [
            "matched",
            "mismatch",
            "unavailable"
          ],
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "scope_note": {
          "type": "string"
        },
        "source_event_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "claim",
        "snapshot",
        "recomputed_value",
        "recomputation",
        "method",
        "scope_note",
        "source_event_ids"
      ],
      "title": "ClaimEvidence",
      "type": "object"
    },
    "CueProvenance": {
      "additionalProperties": false,
      "properties": {
        "metric_ids": {
          "items": {
            "pattern": "^(match|team|player|event)(\\.[A-Za-z0-9_-]+)+$",
            "type": "string"
          },
          "type": "array"
        },
        "checker": {
          "$ref": "#/$defs/CheckerResult"
        },
        "model_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "metric_ids",
        "checker",
        "model_ids"
      ],
      "title": "CueProvenance",
      "type": "object"
    },
    "DuelAttrs": {
      "additionalProperties": false,
      "properties": {
        "opponent_id": {
          "pattern": "^[ha]\\d{2}$",
          "type": "string"
        }
      },
      "required": [
        "opponent_id"
      ],
      "title": "DuelAttrs",
      "type": "object"
    },
    "DuelEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string"
        },
        "match_id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "clock": {
          "$ref": "#/$defs/MatchClock"
        },
        "type": {
          "const": "duel",
          "type": "string"
        },
        "team_id": {
          "enum": [
            "home",
            "away"
          ],
          "type": "string"
        },
        "player_id": {
          "pattern": "^[ha]\\d{2}$",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Point"
        },
        "end_location": {
          "type": "null"
        },
        "outcome": {
          "enum": [
            "won",
            "lost"
          ],
          "type": "string"
        },
        "attrs": {
          "$ref": "#/$defs/DuelAttrs"
        }
      },
      "required": [
        "event_id",
        "match_id",
        "seq",
        "clock",
        "type",
        "team_id",
        "player_id",
        "location",
        "end_location",
        "outcome",
        "attrs"
      ],
      "title": "DuelEvent",
      "type": "object"
    },
    "EvidenceReplay": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/MatchClock"
        },
        "end": {
          "$ref": "#/$defs/MatchClock"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/TrackingFrame"
          },
          "type": "array"
        },
        "events": {
          "items": {
            "discriminator": {
              "mapping": {
                "ball_out": "#/$defs/BallOutEvent",
                "card": "#/$defs/CardEvent",
                "carry": "#/$defs/CarryEvent",
                "duel": "#/$defs/DuelEvent",
                "foul": "#/$defs/FoulEvent",
                "goal": "#/$defs/GoalEvent",
                "interception": "#/$defs/InterceptionEvent",
                "kickoff": "#/$defs/KickoffEvent",
                "match_end": "#/$defs/MatchEndEvent",
                "pass": "#/$defs/PassEvent",
                "period_end": "#/$defs/PeriodEndEvent",
                "possession_change": "#/$defs/PossessionChangeEvent",
                "pressure": "#/$defs/PressureEvent",
                "shot": "#/$defs/ShotEvent",
                "substitution": "#/$defs/SubstitutionEvent",
                "tackle": "#/$defs/TackleEvent"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/KickoffEvent"
              },
              {
                "$ref": "#/$defs/PassEvent"
              },
              {
                "$ref": "#/$defs/CarryEvent"
              },
              {
                "$ref": "#/$defs/ShotEvent"
              },
              {
                "$ref": "#/$defs/TackleEvent"
              },
              {
                "$ref": "#/$defs/InterceptionEvent"
              },
              {
                "$ref": "#/$defs/PressureEvent"
              },
              {
                "$ref": "#/$defs/DuelEvent"
              },
              {
                "$ref": "#/$defs/FoulEvent"
              },
              {
                "$ref": "#/$defs/CardEvent"
              },
              {
                "$ref": "#/$defs/SubstitutionEvent"
              },
              {
                "$ref": "#/$defs/GoalEvent"
              },
              {
                "$ref": "#/$defs/PossessionChangeEvent"
              },
              {
                "$ref": "#/$defs/BallOutEvent"
              },
              {
                "$ref": "#/$defs/PeriodEndEvent"
              },
              {
                "$ref": "#/$defs/MatchEndEvent"
              }
            ]
          },
          "type": "array"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "frames",
        "events",
        "note"
      ],
      "title": "EvidenceReplay",
      "type": "object"
    },
    "EvidenceVersion": {
      "additionalProperties": false,
      "properties": {
        "cue": {
          "$ref": "#/$defs/OverlayCue"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimEvidence"
          },
          "type": "array"
        },
        "numeric_check_passed": {
          "type": "boolean"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/CheckError"
          },
          "type": "array"
        }
      },
      "required": [
        "cue",
        "claims",
        "numeric_check_passed",
        "errors"
      ],
      "title": "EvidenceVersion",
      "type": "object"
    },
